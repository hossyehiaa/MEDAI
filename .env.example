# ==============================================================================
# medAI — Environment Variables Configuration
# ==============================================================================
# Copy this file to `.env` (or `configs/.env`) and populate with your credentials.

# --- LLM Provider Selection ---
# Options: openai | anthropic | ollama | local
LLM_PROVIDER=openai

# --- API Keys ---
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# --- Model Selection ---
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# --- Embedding & Retrieval Configuration ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DB_PATH=data/vector_db
COLLECTION_NAME=uspstf_depression_guidelines
TOP_K=5
