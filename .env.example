# ==============================================================================
# medAI — Environment Variables Configuration
# ==============================================================================
# Copy this file to `.env` and populate with your credentials.

# --- LLM Provider Selection ---
# Options: openrouter | groq | openai | mock
LLM_PROVIDER=openrouter

# --- API Keys ---
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=sk-your-openai-api-key-here

# --- Model Selection ---
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
TEMPERATURE=0.0
MAX_TOKENS=2048

# --- Embedding & Retrieval Configuration ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-MiniLM-L6-v2
VECTOR_DB_PATH=data/vector_db
COLLECTION_NAME=uspstf_depression_guidelines
TOP_K=3
